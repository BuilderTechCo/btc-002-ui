{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "scripts/**/*",
    ".storybook/**/*",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
