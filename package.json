  "scripts": {
    "build": "node scripts/build.mjs",
    "build-storybook": "storybook build",
    "build:watch": "tsc --watch",
    "check:component-files": "node scripts/check-component-files.mjs",
    "check:contract": "node --import ./scripts/register.mjs ./scripts/check-component-contract.ts",
    "check:design": "node --import ./scripts/register.mjs ./scripts/check-design.ts",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:src && pnpm run lint:e2e && pnpm run lint:scripts && pnpm run lint:configs",
    "lint:configs": "eslint . --ext .js,.mjs,.ts,.tsx --max-warnings 0 --report-unused-disable-directives --ignore-pattern 'src/**' --ignore-pattern 'e2e/**' --ignore-pattern 'scripts/**' --ignore-pattern 'dist/**' --ignore-pattern 'storybook-static/**' --ignore-pattern 'coverage/**' --ignore-pattern 'playwright-report/**' --ignore-pattern 'test-results/**' --ignore-pattern 'node_modules/**' --ignore-pattern '.storybook/**' --ignore-pattern '*.tsbuildinfo'",
    "lint:e2e": "eslint e2e --ext .ts,.tsx --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "eslint src --ext .ts,.tsx --fix && eslint e2e --ext .ts,.tsx --fix && eslint scripts --ext .ts,.tsx,.mjs --fix",
    "lint:scripts": "eslint scripts --ext .ts,.tsx,.mjs --max-warnings 0 --report-unused-disable-directives",
    "lint:src": "eslint src --ext .ts,.tsx --max-warnings 0 --report-unused-disable-directives",
    "prepublishOnly": "pnpm run quality:verify && pnpm run check:component-files && pnpm run check:contract && pnpm run check:suppressions && pnpm run test:docs-contract && pnpm run build && pnpm run test:consumer",
    "quality:verify": "pnpm run typecheck && pnpm run lint && pnpm run check:design && pnpm run test",
    "storybook": "lsof -ti:6006 | xargs -r kill -9 && storybook dev -p 6006",
    "storybook:static": "storybook build --output-dir storybook-static",
    "test": "vitest run --project=unit --project=integration",
    "test:consumer": "node scripts/test-package-consumer.mjs",
    "test:coverage": "vitest run --project=unit --project=integration --coverage",
    "test:docs-contract": "node --test scripts/package-docs.test.mjs",
    "test:static": "pnpm run typecheck && pnpm run lint && pnpm run check:component-files && pnpm run check:contract && pnpm run check:suppressions && pnpm run test:docs-contract",
    "test:storybook": "vitest run --project=storybook",
    "test:ui": "vitest --ui",
    "test:visual": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
